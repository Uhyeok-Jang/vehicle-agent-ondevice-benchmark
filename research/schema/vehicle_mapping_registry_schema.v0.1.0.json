{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vehicle-agent-ondevice-benchmark:mapping-registry:0.1.0",
  "title": "Declarative source-to-canonical mapping registry",
  "type": "object",
  "required": [
    "registry_version",
    "status",
    "source_format",
    "vehicle_domain",
    "canonical_schema_file",
    "canonical_registry_file",
    "mapping_outcomes",
    "reason_codes",
    "executable_slot_names",
    "normalizers",
    "rules",
    "outcome_rules"
  ],
  "additionalProperties": false,
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "const": "working_draft"
    },
    "source_format": {
      "const": "macslu"
    },
    "vehicle_domain": {
      "type": "string",
      "minLength": 1
    },
    "canonical_schema_file": {
      "type": "string",
      "minLength": 1
    },
    "canonical_registry_file": {
      "type": "string",
      "minLength": 1
    },
    "mapping_outcomes": {
      "const": [
        "mapped",
        "ambiguous",
        "unsupported",
        "needs_context"
      ]
    },
    "reason_codes": {
      "type": "object",
      "required": [
        "mapped",
        "ambiguous",
        "unsupported",
        "needs_context"
      ],
      "additionalProperties": false,
      "properties": {
        "mapped": {
          "type": "array",
          "maxItems": 0
        },
        "ambiguous": {
          "$ref": "#/$defs/reason_code_array"
        },
        "unsupported": {
          "$ref": "#/$defs/reason_code_array"
        },
        "needs_context": {
          "$ref": "#/$defs/reason_code_array"
        }
      }
    },
    "executable_slot_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "normalizers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/normalizer"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mapping_rule"
      }
    },
    "outcome_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcome_rule"
      }
    }
  },
  "$defs": {
    "reason_code_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "normalized_field": {
      "type": "string",
      "enum": [
        "intent_class",
        "entity",
        "feature",
        "property",
        "operator",
        "operator_modifier",
        "zone",
        "target"
      ]
    },
    "source_path": {
      "type": "string",
      "pattern": "^(intent|slots\\.[^.\\s]+)$"
    },
    "normalizer": {
      "type": "object",
      "required": [
        "id",
        "stage",
        "input",
        "emit"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "stage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "requires": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/normalized_field"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "input": {
          "type": "object",
          "required": [
            "path",
            "values"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "$ref": "#/$defs/source_path"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "emit": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/normalized_field"
          }
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "equals": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/normalized_field"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "in": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/normalized_field"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "present": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/normalized_field"
          }
        },
        "absent": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/normalized_field"
          }
        }
      }
    },
    "argument_binding": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "const"
          ],
          "additionalProperties": false,
          "properties": {
            "const": true
          }
        },
        {
          "type": "object",
          "required": [
            "from"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/normalized_field"
            },
            "optional": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "call_template": {
      "type": "object",
      "required": [
        "function",
        "arguments"
      ],
      "additionalProperties": false,
      "properties": {
        "function": {
          "type": "string",
          "enum": [
            "set_hvac_power",
            "set_hvac_temperature",
            "set_hvac_fan_speed",
            "set_window_position",
            "set_sunroof_position",
            "set_sunshade_position",
            "set_seat_climate",
            "set_seat_massage"
          ]
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/argument_binding"
          }
        }
      }
    },
    "mapping_rule": {
      "type": "object",
      "required": [
        "id",
        "match",
        "consume",
        "emit"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "consume": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/normalized_field"
          }
        },
        "emit": {
          "$ref": "#/$defs/call_template"
        }
      }
    },
    "outcome_rule": {
      "type": "object",
      "required": [
        "id",
        "phase",
        "match",
        "status",
        "reason_code"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "pre_normalization_errors",
            "post_mapping"
          ]
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "status": {
          "type": "string",
          "enum": [
            "ambiguous",
            "unsupported",
            "needs_context"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    }
  }
}
